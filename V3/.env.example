# ── S2S Voice Avatar Server — Environment Variables ──────────────────────────
# Copy this file to .env and edit as needed.
# Used by both docker-compose.yml and the bare uvicorn launch.

# ── HuggingFace (required for vLLM model downloads) ──────────────────────────
# Get your token from https://huggingface.co/settings/tokens
# Required for gated models. Leave blank for fully open models.
HF_TOKEN=

# ── Frontend (Vite dev server) ────────────────────────────────────────────────
VITE_SERVER_HOST=localhost
VITE_SERVER_PORT=8765

# ── Vexyl STT (WebSocket) ─────────────────────────────────────────────────────
VEXYL_STT_URL=ws://localhost:8080
VEXYL_STT_API_KEY=

# ── LLM (OpenAI-compatible /v1/chat/completions) ─────────────────────────────
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=sk-no-key-required
LLM_MODEL=ibm-granite/granite-4.0-nano

# ── TTS: vLLM-Omni (/v1/audio/speech) ────────────────────────────────────────
TTS_BASE_URL=http://localhost:8091/v1
TTS_API_KEY=none
TTS_MODEL=k2-fsa/OmniVoice
TTS_VOICE=default

# ── Translation: IndicTrans2 CTranslate2 model paths ─────────────────────────
# Run `python server/download_models.py` to populate these locations.
INDIC_TRANS2_EN_INDIC=~/.cache/ctranslate2/en-indic-1B
INDIC_TRANS2_INDIC_EN=~/.cache/ctranslate2/indic-en-1B
