# Copy this to .env and edit as needed
# Server host/port as seen from the browser (used by the Vite frontend)
VITE_SERVER_HOST=localhost
VITE_SERVER_PORT=8765

# Hugging Face Token (required for Llama 3.1 access)
# Get your token from: https://huggingface.co/settings/tokens
# Accept Llama 3.1 license at: https://huggingface.co/meta-llama/Llama-3.1-8B
HF_TOKEN=your_huggingface_token_here
