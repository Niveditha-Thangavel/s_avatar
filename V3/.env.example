# ── S2S Voice Avatar Server — Environment Variables ──────────────────────────
# Copy this file to .env and edit as needed.
# Used by both docker-compose.yml and the bare uvicorn launch.

# ── HuggingFace (only needed for FIRST RUN) ─────────────────────────────────
# Get your token from https://huggingface.co/settings/tokens
# Required to download the gated ai4bharat/indic-conformer-600m-multilingual (STT) model.
# Once cached in the Docker volume, you can remove HF_TOKEN entirely.
HF_TOKEN=

# ── Frontend (Vite dev server) ────────────────────────────────────────────────
VITE_SERVER_HOST=localhost
VITE_SERVER_PORT=8765

# ── Vexyl STT (WebSocket) ─────────────────────────────────────────────────────
VEXYL_STT_URL=ws://localhost:8080
VEXYL_STT_API_KEY=

# ── Translation: IndicTrans2 CTranslate2 model paths ─────────────────────────
# Run `python server/download_models.py` to populate these locations.
INDIC_TRANS2_EN_INDIC=~/.cache/ctranslate2/ct2-rotary-indictrans2-en-indic-dist-200M
INDIC_TRANS2_INDIC_EN=~/.cache/ctranslate2/ct2-rotary-indictrans2-indic-en-dist-200M


