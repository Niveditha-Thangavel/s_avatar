# Voice Avatar Server
# All models in one container: OmniVoice TTS + Whisper STT + SMaLL-100 + Granite LLM
# Base: PyTorch 2.5.1 + CUDA 12.4 + cuDNN 9
FROM pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV TOKENIZERS_PARALLELISM=false
ENV TRANSFORMERS_CACHE=/app/.cache/huggingface
ENV HF_HOME=/app/.cache/huggingface
ENV WHISPER_CACHE=/app/.cache/whisper
ENV OMNIVOICE_DEVICE=cuda:0
ENV PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:512
ENV LD_LIBRARY_PATH=/usr/local/nvidia/lib:/usr/local/nvidia/lib64:/usr/local/cuda/lib64:/usr/lib/x86_64-linux-gnu

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg libsndfile1 git curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python dependencies
COPY server/requirements.txt ./
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Copy server source
COPY server/ ./

# Pre-cache all model weights at build time (CPU only — no GPU needed during build)
RUN python3 cache_model.py || echo "[Build] Some models failed to cache — will download at runtime"

EXPOSE 8765

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8765", "--workers", "1"]
