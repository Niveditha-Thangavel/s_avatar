FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /app

# System deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.11 \
    python3.11-dev \
    python3-pip \
    build-essential \
    gcc \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3.11 /usr/local/bin/python3 \
    && ln -sf /usr/bin/python3.11 /usr/local/bin/python

# Bootstrap pip for Python 3.11
RUN curl -sS https://bootstrap.pypa.io/get-pip.py | python3.11

# Upgrade pip
RUN python -m pip install --no-cache-dir --upgrade pip

# Python deps
COPY server/requirements.txt server/
RUN python -m pip install --no-cache-dir torch torchaudio --index-url https://download.pytorch.org/whl/cu124
RUN python -m pip install --no-cache-dir -r server/requirements.txt

# Model cache paths
ENV CTRANSLATE2_CACHE=/root/.cache/ctranslate2
ENV HF_HOME=/root/.cache/huggingface

# Server source code + startup downloader
COPY server/*.py server/
COPY server/ref_audio.wav server/ref_text.txt server/
COPY server/entrypoint.sh ./

RUN chmod +x entrypoint.sh

ENV PYTHONUNBUFFERED=1
ENV TOKENIZERS_PARALLELISM=false

# Default service URLs (override at runtime via docker-compose)
ENV VEXYL_STT_URL=ws://vexyl-stt:8080

# Device for CTranslate2 translation models.
ENV TRANSLATION_DEVICE=cuda

EXPOSE 8765

ENTRYPOINT ["./entrypoint.sh"]
