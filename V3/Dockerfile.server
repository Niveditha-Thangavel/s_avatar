# Dockerfile.server — S2S Pipeline Orchestrator backend
# Pipeline: Vexyl STT → IndicTrans2 (CT2) → LLM → IndicTrans2 (CT2) → vLLM-Omni TTS
#
# Build context must be the project root (V3/) — not server/ subdirectory.
#
# Build:
#   docker build -f Dockerfile.server -t avatar-server .

FROM python:3.11-slim

WORKDIR /app

# System deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Python deps (no PyTorch needed — CTranslate2 only)
COPY server/requirements.txt server/
RUN pip install --no-cache-dir -r server/requirements.txt

# Model cache path
ENV CTRANSLATE2_CACHE=/root/.cache/ctranslate2

# Pre-download IndicTrans2 CT2 models at build time
COPY server/__init__.py      server/
COPY server/download_models.py server/
RUN python server/download_models.py

# Server source (late copy — doesn't bust model cache layer)
COPY server/*.py      server/

ENV PYTHONUNBUFFERED=1
ENV TOKENIZERS_PARALLELISM=false

# External service URLs (override at runtime)
ENV VEXYL_STT_URL=ws://vexyl-stt:8080
ENV LLM_BASE_URL=http://llm:8000/v1
ENV TTS_BASE_URL=http://vllm-omni:8091/v1

EXPOSE 8765

CMD ["uvicorn", "server.main:app", \
     "--host", "0.0.0.0", \
     "--port", "8765", \
     "--loop", "asyncio", \
     "--log-level", "info"]
