# Dockerfile.server — Python backend (Whisper STT, SMaLL-100, Granite, OmniVoice, PantoMatrix)
#
# Build context must be the project root (V3/) — not server/ subdirectory.
#
# Local (M-series Mac):
#   docker build -f Dockerfile.server -t avatar-server .
#
# GPU server (override base image & torch index):
#   docker build -f Dockerfile.server \
#     --build-arg BASE_IMAGE=pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime \
#     --build-arg TORCH_INDEX_URL=https://download.pytorch.org/whl/cu124 \
#     -t avatar-server .

ARG BASE_IMAGE=python:3.11-slim
FROM $BASE_IMAGE

# Default: CPU-only torch (works on both ARM64 and x86_64 Linux)
ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu

# GPU base images (pytorch/pytorch) ship torch via conda — pip would re-download.
# Set SKIP_TORCH_INSTALL=true to skip this layer on GPU builds.
ARG SKIP_TORCH_INSTALL=false

WORKDIR /app/server

# System deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    curl \
    perl \
    ffmpeg \
    libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

# PyTorch (CPU by default; override via --build-arg for CUDA)
RUN if [ "$SKIP_TORCH_INSTALL" != "true" ]; then \
      pip install --no-cache-dir torch==2.5.1 torchaudio==2.5.1 --index-url $TORCH_INDEX_URL; \
    fi

# Python deps
COPY server/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Consistent model cache paths — match docker-compose volumes
ENV TRANSFORMERS_CACHE=/root/.cache/huggingface

# Pre-download all models at build time
COPY server/download_models.py .
RUN python download_models.py

# Server source
COPY server/*.py ./

# Reference audio for voice cloning (late copy — doesn't invalidate model cache)
COPY server/ref_audio.wav server/ref_text.txt ./

ENV PYTHONUNBUFFERED=1
ENV TOKENIZERS_PARALLELISM=false

EXPOSE 8765

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8765", "--log-level", "info"]
