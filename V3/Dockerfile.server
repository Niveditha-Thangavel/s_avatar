# Dockerfile.server — Python backend
# Pipeline: Faster-Whisper STT → Granite 4.0 LLM → SMaLL-100 Trans → OmniVoice TTS
#
# Build context must be the project root (V3/) — not server/ subdirectory.
#
# Local (CPU):
#   docker build -f Dockerfile.server -t avatar-server .
#
# GPU server:
#   docker compose -f docker-compose.yml -f docker-compose.gpu.yml up -d

ARG BASE_IMAGE=python:3.11-slim
FROM $BASE_IMAGE

# Default: CPU-only torch. GPU builds override this.
ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu

# GPU base images (pytorch/pytorch) ship torch via conda — skip pip reinstall.
ARG SKIP_TORCH_INSTALL=false

# WORKDIR=/app so `from server.xxx import` resolves to /app/server/xxx.py
WORKDIR /app

# System deps — identical to the working commit
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    curl \
    perl \
    ffmpeg \
    libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

# PyTorch (skipped on GPU conda builds)
RUN if [ "$SKIP_TORCH_INSTALL" != "true" ]; then \
      pip install --no-cache-dir torch==2.5.1 torchaudio==2.5.1 \
        --index-url $TORCH_INDEX_URL; \
    fi

# Python deps
COPY server/requirements.txt server/
RUN pip install --no-cache-dir -r server/requirements.txt

# Model cache paths — must match runtime engine defaults
ENV TRANSFORMERS_CACHE=/root/.cache/huggingface
ENV FASTER_WHISPER_CACHE=/root/.cache/faster_whisper

# Pre-download all models at build time
# Layer order: download script → models (heavy cached layer) → source files
# Editing .py source does NOT bust the model-download cache layer.
COPY server/__init__.py      server/
COPY server/download_models.py server/
RUN python server/download_models.py

# Server source (late copy)
COPY server/*.py      server/
COPY server/ref_audio.wav server/ref_text.txt server/

ENV PYTHONUNBUFFERED=1
ENV TOKENIZERS_PARALLELISM=false

EXPOSE 8765

CMD ["uvicorn", "server.main:app", \
     "--host", "0.0.0.0", \
     "--port", "8765", \
     "--loop", "asyncio", \
     "--log-level", "info"]
