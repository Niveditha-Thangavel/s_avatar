
FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /app

# System deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.11 \
    python3.11-dev \
    python3-pip \
    build-essential \
    gcc \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3.11 /usr/local/bin/python3 \
    && ln -sf /usr/bin/python3.11 /usr/local/bin/python

# Bootstrap pip for Python 3.11
RUN curl -sS https://bootstrap.pypa.io/get-pip.py | python3.11

# Upgrade pip
RUN python -m pip install --no-cache-dir --upgrade pip

# Python deps
COPY server/requirements.txt server/
RUN python -m pip install --no-cache-dir -r server/requirements.txt

# Model cache path (used both at build time and runtime)
ENV CTRANSLATE2_CACHE=/root/.cache/ctranslate2
ENV HF_HOME=/root/.cache/huggingface

ARG HF_TOKEN=""
ENV HF_TOKEN=$HF_TOKEN

# Pre-download IndicTrans2 CT2 and OmniVoice models at build time.
# Models are verified on CPU here; at runtime they load on CUDA via TRANSLATION_DEVICE.
COPY server/__init__.py       server/
COPY server/download_models.py server/
RUN python server/download_models.py

# Server source (late copy — doesn't bust model cache layer)
COPY server/*.py server/
COPY server/ref_audio.wav server/ref_text.txt server/

ENV PYTHONUNBUFFERED=1
ENV TOKENIZERS_PARALLELISM=false

# Default service URLs (override at runtime via docker-compose)
ENV VEXYL_STT_URL=ws://vexyl-stt:8080

# Device for CTranslate2 translation models.
# Set to "cuda" in docker-compose.gpu.yml for GPU inference.
ENV TRANSLATION_DEVICE=cpu


EXPOSE 8765

CMD ["uvicorn", "server.main:app", \
     "--host", "0.0.0.0", \
     "--port", "8765", \
     "--loop", "asyncio", \
     "--log-level", "info"]
